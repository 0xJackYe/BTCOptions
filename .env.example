# BTC 期权策略看板 · 服务端配置示例
#
# 复制为 .env（已被 git 忽略）后填写。不填写时：公开行情、策略筛选、风险分析
# 全部可用；只有「账户」相关功能（持仓、保证金、已用风险预算）不可用。
#
# 仅使用「只读」权限的币安 API Key：在币安 API 管理中只勾选「允许读取」，
# 不要勾选交易、提现或划转；建议绑定 IP 白名单。本项目没有任何下单代码。

# 64 位字母数字。服务器用 Secret 在本机计算 HMAC-SHA256 签名，Secret 不会发给浏览器。
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 仅在公网部署（Render，BTCOPT_HOSTED=1）时需要：至少 24 位随机字符串。
# 未设置时，公网后端会拒绝返回账户数据（默认拒绝）。在看板「账户」面板输入同一个令牌即可读取。
# 生成示例：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BTCOPT_ACCESS_TOKEN=

# 本机连接器端口（默认 8767）。
# BTCOPT_BRIDGE_PORT=8767

# 开发 / 演示：回放已记录的币安快照（冻结在快照时刻，界面显示「回放」标记）。
# 仅限本机，公网部署会拒绝启动。
# BTCOPT_REPLAY=analysis/put-20261030/snapshot.json
# BTCOPT_REPLAY_KLINES=analysis/put-20261030/spot_daily.json
