/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' http://127.0.0.1:8767 wss://fstream.binance.com https://data-api.binance.vision https://api.binance.com; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
/account*
  Cache-Control: no-store
/version.json
  Cache-Control: no-store
/strategy/fonts/*
  Cache-Control: public, max-age=31536000, immutable
